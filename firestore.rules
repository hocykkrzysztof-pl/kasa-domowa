rules_version = '2';

// Kasa Domowa
// households/{uid}: budżet (owner, members, limits)
// households/{hid}/tx/{id}: wpisy budżetu
// invites/{email}/from/{hid}: zaproszenia domowników
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember(h) {
      return signedIn()
        && (h.owner == request.auth.uid
          || myEmail() in h.members);
    }

    function house(hid) {
      return get(
        /databases/$(database)/documents/households/$(hid)
      ).data;
    }

    function validTx(t) {
      return t.keys().hasOnly(
          ['d', 'm', 't', 'c', 'a', 'n', 'by', 'at', 'ex'])
        && t.d is string
        && t.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && t.m is string
        && t.m == t.d[0:7]
        && t.t in ['exp', 'inc']
        && t.c is string
        && t.c.size() <= 40
        && t.a is number
        && t.a > 0
        && t.a < 1000000000
        && t.n is string
        && t.n.size() <= 80
        && t.by is string
        && t.get('ex', false) is bool;
    }

    function isOwner(h) {
      return h.owner == request.auth.uid;
    }

    function onlyLimits() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(['limits']);
    }

    match /households/{hid} {
      allow get: if signedIn()
        && (hid == request.auth.uid
          || isMember(resource.data));

      allow create: if signedIn()
        && hid == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.limits is map;

      // właściciel zmienia wszystko oprócz właściciela,
      // domownik tylko limity
      allow update: if isMember(resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.members is list
        && request.resource.data.limits is map
        && (isOwner(resource.data) || onlyLimits());

      match /tx/{tid} {
        allow read, delete: if isMember(house(hid));
        allow create, update: if isMember(house(hid))
          && validTx(request.resource.data);
      }
    }

    match /invites/{email}/from/{hid} {
      allow read: if signedIn() && email == myEmail();
      allow create, update: if signedIn()
        && hid == request.auth.uid
        && request.resource.data.hid == hid;
      allow delete: if signedIn()
        && (hid == request.auth.uid || email == myEmail());
    }
  }
}
